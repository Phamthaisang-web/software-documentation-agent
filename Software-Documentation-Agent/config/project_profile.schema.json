{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectProfile",
  "description": "Structured Profile of a Software Project analyzed from source code, configs, tests, and documentation",
  "type": "object",
  "required": [
    "project_id",
    "project_name",
    "analysis_timestamp",
    "status",
    "business_problem",
    "technologies",
    "functional_requirements",
    "non_functional_requirements",
    "system_architecture",
    "data_models",
    "apis",
    "roles_and_permissions",
    "testing_strategy",
    "missing_information",
    "conflicting_information"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "project_name": {
      "type": "string"
    },
    "project_goal": {
      "type": "string"
    },
    "analysis_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["VERIFIED", "INFERRED", "PARTIALLY_VERIFIED", "UNKNOWN", "CONFLICT"]
    },
    "business_problem": {
      "type": "object",
      "required": ["description", "status"],
      "properties": {
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["VERIFIED", "INFERRED", "UNKNOWN", "CONFLICT"] },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "users_and_stakeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "status"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "influence": { "type": "string" },
          "status": { "type": "string", "enum": ["VERIFIED", "INFERRED", "UNKNOWN", "CONFLICT"] },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "in_scope": { "type": "array", "items": { "type": "string" } },
        "out_of_scope": { "type": "array", "items": { "type": "string" } }
      }
    },
    "technologies": {
      "type": "object",
      "required": ["languages", "frameworks"],
      "properties": {
        "languages": { "type": "array", "items": { "type": "string" } },
        "frameworks": { "type": "array", "items": { "type": "string" } },
        "databases": { "type": "array", "items": { "type": "string" } },
        "libraries": { "type": "array", "items": { "type": "string" } },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "system_architecture": {
      "type": "object",
      "required": ["style", "components", "status"],
      "properties": {
        "style": { "type": "string" },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "status"],
            "properties": {
              "name": { "type": "string" },
              "purpose": { "type": "string" },
              "status": { "type": "string", "enum": ["VERIFIED", "INFERRED", "UNKNOWN", "CONFLICT"] },
              "evidence_refs": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["VERIFIED", "INFERRED", "UNKNOWN", "CONFLICT"] },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "functional_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "status": { "type": "string", "enum": ["VERIFIED", "INFERRED", "UNKNOWN", "CONFLICT"] },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "non_functional_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "target_metric", "status"],
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "target_metric": { "type": "string" },
          "status": { "type": "string", "enum": ["VERIFIED", "INFERRED", "UNKNOWN", "CONFLICT"] },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "data_models": {
      "type": "object",
      "required": ["entities", "status"],
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "status"],
            "properties": {
              "name": { "type": "string" },
              "attributes": { "type": "array", "items": { "type": "string" } },
              "relationships": { "type": "array", "items": { "type": "string" } },
              "status": { "type": "string", "enum": ["VERIFIED", "INFERRED", "UNKNOWN", "CONFLICT"] },
              "evidence_refs": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "status": { "type": "string", "enum": ["VERIFIED", "INFERRED", "UNKNOWN", "CONFLICT"] }
      }
    },
    "apis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "method", "path", "status"],
        "properties": {
          "id": { "type": "string" },
          "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD"] },
          "path": { "type": "string" },
          "auth_required": { "type": "boolean" },
          "status": { "type": "string", "enum": ["VERIFIED", "INFERRED", "UNKNOWN", "CONFLICT"] },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "roles_and_permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "permissions", "status"],
        "properties": {
          "role": { "type": "string" },
          "permissions": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string", "enum": ["VERIFIED", "INFERRED", "UNKNOWN", "CONFLICT"] },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "external_integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["system_name", "status"],
        "properties": {
          "system_name": { "type": "string" },
          "type": { "type": "string" },
          "status": { "type": "string", "enum": ["VERIFIED", "INFERRED", "UNKNOWN", "CONFLICT"] },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "deployment_environments": {
      "type": "object",
      "properties": {
        "containerized": { "type": "boolean" },
        "orchestration": { "type": "string" },
        "ci_cd_pipelines": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["VERIFIED", "INFERRED", "UNKNOWN", "CONFLICT"] }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "auth_methods": { "type": "array", "items": { "type": "string" } },
        "encryption": { "type": "string" },
        "status": { "type": "string", "enum": ["VERIFIED", "INFERRED", "UNKNOWN", "CONFLICT"] }
      }
    },
    "testing_strategy": {
      "type": "object",
      "required": ["automated_tests_found", "status"],
      "properties": {
        "automated_tests_found": { "type": "boolean" },
        "frameworks": { "type": "array", "items": { "type": "string" } },
        "execution_evidence": { "type": "string" },
        "status": { "type": "string", "enum": ["VERIFIED", "INFERRED", "UNKNOWN", "CONFLICT"] }
      }
    },
    "project_management": {
      "type": "object",
      "properties": {
        "methodology": { "type": "string" },
        "sprint_length_weeks": { "type": "number", "maximum": 4.35 },
        "status": { "type": "string", "enum": ["VERIFIED", "INFERRED", "UNKNOWN", "CONFLICT"] }
      }
    },
    "known_risks_and_limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "severity"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "mitigation": { "type": "string" }
        }
      }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "impact", "recommended_action"],
        "properties": {
          "item": { "type": "string" },
          "impact": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "BLOCKING"] },
          "recommended_action": { "type": "string" }
        }
      }
    },
    "conflicting_information": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "source_a", "source_b", "status"],
        "properties": {
          "topic": { "type": "string" },
          "source_a": { "type": "string" },
          "source_b": { "type": "string" },
          "status": { "type": "string", "enum": ["OPEN", "RESOLVED", "NEEDS_USER_INPUT"] }
        }
      }
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref_id", "source_path", "source_type"],
        "properties": {
          "ref_id": { "type": "string" },
          "source_path": { "type": "string" },
          "source_type": { "type": "string" }
        }
      }
    }
  }
}