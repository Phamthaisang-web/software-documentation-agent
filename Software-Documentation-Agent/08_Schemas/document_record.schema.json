{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocumentRecord",
  "description": "Schema for registered software documentation type in the Document Registry",
  "type": "object",
  "required": [
    "document_id",
    "official_name",
    "group",
    "purpose",
    "applicability",
    "required_inputs",
    "output_formats",
    "rule_references",
    "preferred_template_id",
    "related_standards",
    "required_sections",
    "validation_profile"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "^DOC-[A-Z]+-[0-9]{3}$"
    },
    "official_name": { "type": "string" },
    "aliases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "group": {
      "type": "string",
      "enum": [
        "Project_Management",
        "Requirements",
        "Scrum",
        "Architecture_Design",
        "Testing_Quality",
        "Delivery"
      ]
    },
    "purpose": { "type": "string" },
    "applicability": { "type": "string" },
    "is_optional": { "type": "boolean" },
    "required_inputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "optional_inputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "output_formats": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rule_references": {
      "type": "array",
      "items": { "type": "string" }
    },
    "preferred_template_id": { "type": "string" },
    "related_standards": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_sections": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "traceability_requirements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "validation_profile": { "type": "string" },
    "version": { "type": "string" },
    "lifecycle_status": {
      "type": "string",
      "enum": ["DRAFT", "ACTIVE", "UNDER_REVIEW", "APPROVED", "DEPRECATED", "SUPERSEDED"]
    }
  }
}